# =====================================================
# GitVanta API: environment variables
# =====================================================
# Copy to .env (or .env.local, which wins over .env) and fill in.
# Never commit real values. Both files are gitignored.

# ---------- Server ----------
PORT=5000
NODE_ENV=development
# Reverse proxies in front of the API (Render, Railway, Nginx...). Needed so
# rate limits apply per client IP. Defaults to 1 in production, off otherwise.
# TRUST_PROXY=1

# ---------- Database ----------
MONGODB_URI=mongodb://localhost:27017/gitvanta

# ---------- Auth ----------
# Long random string, at least 32 characters:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# GitHub OAuth app: https://github.com/settings/developers
# Callback URL must match the one configured on the OAuth app.
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:5000/api/auth/github/callback

# ---------- Frontend ----------
# Where users are sent after sign-in, and the base of public profile links.
FRONTEND_URL=http://localhost:5173
# Comma-separated origins allowed by CORS. Defaults to FRONTEND_URL.
# CORS_ORIGINS=https://gitvanta.example.com,https://www.gitvanta.example.com

# ---------- Users' own AI keys ----------
# 32-byte key used to encrypt users' saved API keys (AES-256-GCM).
# Without it, users can test keys but cannot save them.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing it makes every saved key unreadable (users will be asked to re-enter).
ENCRYPTION_KEY=

# Allow custom AI base URLs on private/local addresses (Ollama, LM Studio).
# Defaults to true in development and false in production, where it would let
# users make the server call internal services.
# ALLOW_PRIVATE_AI_URLS=false

# ---------- Server AI provider (optional) ----------
# Used for users who haven't added their own key. If no key is set here,
# AI features work only for users with their own key.
# One of: groq, openai, anthropic, gemini, openrouter, mistral, deepseek, together, custom
AI_PROVIDER=groq

# Set the key for the provider you chose:
GROQ_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=          # Gemini (GEMINI_API_KEY is also accepted)
# OPENROUTER_API_KEY=
# MISTRAL_API_KEY=
# DEEPSEEK_API_KEY=
# TOGETHER_API_KEY=
# For AI_PROVIDER=custom (any OpenAI-compatible server):
# AI_BASE_URL=https://your-server.example.com/v1
# AI_API_KEY=

# Optional overrides. Defaults: the provider's recommended model, 4096, 0.7
# AI_MODEL=openai/gpt-oss-120b
# AI_MAX_TOKENS=4096
# AI_TEMPERATURE=0.7

# ---------- Rate limits ----------
# All API routes, per IP
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
# AI requests per user per hour (shared server key / user's own key)
# AI_RATE_LIMIT_PER_HOUR=50
# AI_RATE_LIMIT_OWN_KEY_PER_HOUR=500

# ---------- Redis (optional caching) ----------
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=false
