# GitVanta frontend: copy to .env.local and adjust.

# API base URL, including /api. In development, leaving this unset uses the
# Vite proxy to http://localhost:5000.
VITE_API_URL=http://localhost:5000/api

# Public site URL, used for canonical and Open Graph tags.
# On Vercel this falls back to the production domain automatically.
# VITE_SITE_URL=https://gitvanta.example.com
